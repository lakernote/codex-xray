{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codex X-Ray",
  "version": "0.1.7",
  "identifier": "app.codexxray.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex X-Ray",
        "width": 1280,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "See, understand, and configure every layer of Codex."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBRjA4NEQ0REI3MkJEMUEKUldRYXZYTGIxSVR3YXVQQTNSZjl3NXRmeUJhbko1OUp3aXYrbldyUkRkb0VTVndKUmxsRFFrSHEK",
      "endpoints": [
        "https://github.com/lakernote/codex-xray/releases/latest/download/latest.json"
      ]
    }
  }
}
